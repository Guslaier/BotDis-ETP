# ==============================================================================
# DISLAVA MUSIC BOT - CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# 1. Discord Bot Token (Required)
DISCORD_TOKEN=your_discord_bot_token_here

# 2. VPN Tunnel Egress (ProtonVPN / Isolated OpenVPN)
# true  = Use isolated VPN tunnel (binds yt-dlp to tun interface, bypasses YouTube IP bans)
# false = Disable VPN egress and stop isolated VPN service
ENABLE_VPN=true

# Optional: Manual VPN Source IP override (leave empty to auto-detect from tun interface or /root/vpn/vpn_ip.txt)
VPN_SOURCE_IP=

# Optional: OpenVPN credentials for auto-provisioning /root/vpn/auth.txt
VPN_USERNAME=
VPN_PASSWORD=

# 3. Dynamic Free Proxy Pool (Auto-scraping from ProxyScrape / GeoNode)
# true  = Continuously discover and benchmark public proxies
# false = Disable public scraping (recommended when VPN is active to save CPU and RAM)
ENABLE_FREE_PROXY=false

# 4. Static VIP Proxy (Optional)
# If provided, routes requests through this proxy (e.g. residential proxy)
# Leave empty to use VPN or Direct bypass
PROXY_URL=

# 5. Network Settings
USE_IPV6=true

# 6. Audio Streaming & Buffering Architecture
# ------------------------------------------------------------------------------
# STREAM_MODE:
# - cache : (Recommended for zero-stutter) Downloads full track to disk before playback.
#           Guarantees 100% rock-solid, jitter-free playback from local NVMe/SSD.
# - pipe  : Ultra-low latency start (<2s). Streams directly to Discord without caching.
# - auto  : Hybrid mode. Direct Live Pipe for long tracks (>6 min); Disk cache for short songs (<=6 min).
STREAM_MODE=auto

# 7. Live Pipe Buffer Settings (Used when STREAM_MODE=pipe or auto)
STREAM_BUFFER_SIZE=1M
STREAM_CHUNK_SIZE=1M
STREAM_SOCKET_TIMEOUT=10
PRE_BUFFER_KB=64
PRE_BUFFER_TIMEOUT_MS=300
PASSTHROUGH_BUFFER_KB=1024
THREAD_QUEUE_SIZE=2048

# 8. Audio Quality & Voice Connection Tolerance
# Discord standard voice channels cap at 96 kbps (VIP: 96k, Standard: 64k)
OPUS_BITRATE=96k
MAX_MISSED_FRAMES=500
DEFAULT_VOLUME=100

# 9. Anti-Ban Circuit Breaker & Fallback
# Time in milliseconds before retrying YouTube after rate limit detection (default: 300000 = 5 minutes)
YT_CIRCUIT_COOLDOWN_MS=300000

# 10. Cache Timeouts & Quota (Used when STREAM_MODE=cache or auto)
DOWNLOAD_TIMEOUT_MS=35000
DOWNLOAD_TIMEOUT_BG_MS=50000
CACHE_MAX_SIZE_MB=350
CACHE_MAX_AGE_HOURS=6

# 11. Web Admin & TrueMoney Donation Portal
ENABLE_WEB_ADMIN=true
WEB_PORT=11901
PUBLIC_WEB_URL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password
AUTH_SECRET=generate_a_random_sha256_secret_key
NODE_AUTH_SECRET=generate_a_cluster_node_secret_key

# 12. Payment & Subscription Economics
# PAYMENT_MODE: sandbox (simulates TEST10, TEST29, TEST50) | production (redeems real vouchers)
PAYMENT_MODE=sandbox
TMW_PHONE_NUMBER=0812345678
PRICE_30_DAYS=29
MAX_FREE_STREAMS=6
MAX_TOTAL_STREAMS=12
# Max concurrent live stream cold spawns on this node (0 = auto-detect based on CPU/RAM)
MAX_CONCURRENT_SPAWNS=0

# 13. Audio Nodes Cluster (Scale-Out Architecture)
# Define remote audio worker nodes on Controller as JSON array. Leave empty for standalone single node (LocalNode-0).
# Note: Only 'host' and 'port' are required. The node automatically synchronizes its Name and Max Streams,
# and the Admin can edit them dynamically at any time via the Web Dashboard.
# Example: REMOTE_NODES='[{"host":"103.20.10.15","port":2333},{"host":"133.15.20.30","port":2333}]'
REMOTE_NODES=

# Audio Node Worker Settings (Used on the worker machine when running: npm run node)
NODE_PORT=2333
NODE_ID=node-worker-1
NODE_NAME="SG Audio Worker 1"
# Secret key shared between Controller and Audio Nodes (must match on all cluster nodes)
NODE_AUTH_SECRET=generate_a_cluster_node_secret_key

# 14. Optional MongoDB Cloud Persistence (Leave blank for Zero-RAM local atomic JSON store)
MONGODB_URI=
